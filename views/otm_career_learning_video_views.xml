<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_otm_career_learning_video_form" model="ir.ui.view">
        <field name="name">otm.career.learning.video.form</field>
        <field name="model">otm.career.learning.video</field>
        <field name="arch" type="xml">
            <form string="Learning Video">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="title" placeholder="Video Title"/></h1>
                    </div>
                    <group>
                        <field name="video_url"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                    <field name="embed_code" widget="text"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_otm_career_learning_video_list" model="ir.ui.view">
        <field name="name">otm.career.learning.video.list</field>
        <field name="model">otm.career.learning.video</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="title"/>
                <field name="video_url"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_otm_career_learning_video" model="ir.actions.act_window">
        <field name="name">Learning Videos</field>
        <field name="res_model">otm.career.learning.video</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
