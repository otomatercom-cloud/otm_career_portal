<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_otm_career_notice_form" model="ir.ui.view">
        <field name="name">otm.career.notice.form</field>
        <field name="model">otm.career.notice</field>
        <field name="arch" type="xml">
            <form string="Notice">
                <sheet>
                    <group>
                        <field name="title"/>
                        <field name="date"/>
                        <field name="priority"/>
                        <field name="active"/>
                    </group>
                    <field name="message"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_otm_career_notice_list" model="ir.ui.view">
        <field name="name">otm.career.notice.list</field>
        <field name="model">otm.career.notice</field>
        <field name="arch" type="xml">
            <list>
                <field name="date"/>
                <field name="title"/>
                <field name="priority" widget="badge" decoration-danger="priority == 'high'"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_otm_career_notice" model="ir.actions.act_window">
        <field name="name">Notice Board</field>
        <field name="res_model">otm.career.notice</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
